{
  "manifest_version": 3,
  "name": "Floating Chat",
  "version": "1.1",
  "description": "Chat Everywhere floating chat",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}